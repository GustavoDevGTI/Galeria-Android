    <string name="access_full_title">Permitir administrar archivos</string>
    <string name="access_full_explanation">El acceso completo permite encontrar contenido oculto o no indexado, crear carpetas en cualquier lugar y realizar operaciones en lote. La galería sigue funcionando con el contenido autorizado sin este acceso.</string>
